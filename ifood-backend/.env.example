# Mock do iFood (pagamentos). Roda na mesma máquina que o ai-backend.
PORT=3001

# Mesmo Postgres do docker compose do ai-backend (o mock só usa o schema "mock_ifood").
DATABASE_URL=postgresql://ifood:ifood@localhost:5433/ifood

# RabbitMQ do docker compose do ai-backend
RABBITMQ_URL=amqp://ifood:ifood@localhost:5672

# O ai-backend precisa usar a mesma chave (PAYMENTS_API_KEY)
MOCK_API_KEY=dev-mock-key
# Segredo que gera os tokens dos links de pagamento
MOCK_TOKEN_SECRET=dev-token-secret
