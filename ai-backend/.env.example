# ─── Telegram ────────────────────────────────────────────────
# Obtenha em: https://t.me/BotFather  →  /newbot
TELEGRAM_BOT_TOKEN=SEU_TOKEN_AQUI

# ─── Anthropic / Claude ──────────────────────────────────────
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=SEU_API_KEY_AQUI

# URL do servidor MCP que expõe as ferramentas do iFood
MCP_SERVER_URL=http://localhost:3001/mcp

# ─── Banco de dados (docker compose up -d) ───────────────────
DATABASE_URL=postgresql://ifood:ifood@localhost:5433/ifood

# ─── OAuth iFood ─────────────────────────────────────────────
# Cliente OAuth registrado no iFood MCP Developer Portal
IFOOD_CLIENT_ID=SEU_CLIENT_ID
IFOOD_CLIENT_SECRET=SEU_CLIENT_SECRET
# Rota de callback deste backend (precisa ser idêntica à registrada no iFood)
IFOOD_REDIRECT_URI=http://localhost:3000/redirect
# Escopos separados por espaço
IFOOD_SCOPES="mcp.user.basic.read mcp.user.advanced.read mcp.user.addresses.read mcp.user.behavior.read mcp.user.addresses.write mcp.discovery mcp.discovery.search.read mcp.discovery.browse.read mcp.discovery.recommendation.read mcp.discovery.details.read mcp.cart mcp.cart.read mcp.cart.write mcp.cart.checkout mcp.orders.read"

# ─── Aplicação ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
