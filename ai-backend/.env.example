# ─── Telegram ────────────────────────────────────────────────
# Obtenha em: https://t.me/BotFather  →  /newbot
TELEGRAM_BOT_TOKEN=SEU_TOKEN_AQUI

# ─── Anthropic / Claude ──────────────────────────────────────
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=SEU_API_KEY_AQUI

# URL do servidor MCP que expõe as ferramentas do iFood
MCP_SERVER_URL=https://consumer-mcp.ifood.com.br/marketplace

# ─── Banco de dados (docker compose up -d) ───────────────────
DATABASE_URL=postgresql://ifood:ifood@localhost:5433/ifood

# ─── Pagamentos (mock do iFood em ../ifood-backend + RabbitMQ) ──
# Mock do iFood que cria as cobranças e confirma os pagamentos (porta 3001)
PAYMENTS_API_URL=http://localhost:3001
# Mesma chave do MOCK_API_KEY do ifood-backend
PAYMENTS_API_KEY=dev-mock-key
# Link enviado ao pagador no Telegram. Aponta para o front que roda neste computador
# ({token} é obrigatório). Troque a porta/rota pelas do seu front.
PAYMENT_LINK_TEMPLATE=http://localhost:5173/pay/{token}
# Validade do link de pagamento
PAYMENT_TTL_MINUTES=1440
# Fila de eventos (payment.confirmed)
RABBITMQ_URL=amqp://ifood:ifood@localhost:5672
# Ferramentas do MCP cujo nome casa com este regex ficam escondidas do LLM até o pedido estar
# totalmente pago (e o checkout é barrado para carrinhos não pagos). Sem valor, vale o padrão
# submit_?order|checkout (casa o submitOrder do MCP real).
MCP_CHECKOUT_TOOL_PATTERN=
# Opcional: regex das ferramentas do MCP que adicionam item ao carrinho. Para quem tem restrição
# alimentar salva, o item precisa ter passado pelo diet_check_items (padrão: add_?(item_?)?to_?cart).
DIET_GUARDED_TOOL_PATTERN=

# Ferramentas do MCP que alteram um carrinho (nomes separados por vírgula). Depois de cada uma, o
# código lê o carrinho com getCart e o registra no pedido em grupo. Padrão: addItemToCart,
# updateCartItem, removeItemFromCart, setCartDelivery, setVoucher, removeVoucher.
MCP_CART_SYNC_TOOLS=

# ─── Configuração de IA do agente (src/agent/agent.config.ts) ───
# Sem valor, valem defaults baratos feitos para testes (Haiku, effort low, limites curtos).
# Em produção, defina todos. Valor inválido impede o back de subir.
# Modelo da Anthropic.
AGENT_MODEL=claude-haiku-5-5
# Esforço do modelo: low | medium | high | xhigh | max.
AGENT_EFFORT=medium
# Limite de tokens por resposta, raciocínio incluído (1024 a 21000).
AGENT_MAX_TOKENS=16000
# Rodadas de ferramentas por mensagem do usuário (1 a 30).
AGENT_MAX_TOOL_ROUNDS=12
# Linhas do histórico que entram no contexto (2 a 200).
AGENT_HISTORY_ROWS=40
# Tamanho máximo, em caracteres, de resultados de ferramentas antigos no contexto (500 a 20000).
AGENT_HISTORY_TOOL_RESULT_CHARS=4000

# ─── Segurança ───────────────────────────────────────────────
# Chave AES-256 (32 bytes em base64) que cifra os tokens do iFood e o PKCE no banco.
# O ./dev.sh gera uma sozinho; para gerar na mão:  openssl rand -base64 32
# Se for trocada, os tokens guardados não decifram e cada usuário precisa logar de novo.
TOKEN_ENCRYPTION_KEY=

# ─── OAuth iFood ─────────────────────────────────────────────
# Cliente OAuth registrado no iFood MCP Developer Portal
IFOOD_CLIENT_ID=SEU_CLIENT_ID
IFOOD_CLIENT_SECRET=SEU_CLIENT_SECRET
# Servidor de autenticação do iFood (a documentação cita id.ifood.com.br e auth.ifood.com.br;
# para o ambiente de desenvolvimento: https://dev-auth.ifood.com.br)
# IFOOD_AUTH_BASE_URL=https://id.ifood.com.br
# Rota de callback deste backend (precisa ser idêntica à registrada no iFood)
IFOOD_REDIRECT_URI=http://localhost:3000/redirect
# Escopos separados por espaço
IFOOD_SCOPES="mcp.user.basic.read mcp.user.advanced.read mcp.user.addresses.read mcp.user.behavior.read mcp.user.addresses.write mcp.discovery mcp.discovery.search.read mcp.discovery.browse.read mcp.discovery.recommendation.read mcp.discovery.details.read mcp.cart mcp.cart.read mcp.cart.write mcp.cart.checkout mcp.orders.read"

# ─── Aplicação ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Chave exigida no header x-internal-api-key da rota POST /telegram/send (sem ela, a rota fica desligada)
INTERNAL_API_KEY=
# Opcional: nomes exatos (separados por vírgula) das ferramentas MCP que exigem /confirmar.
# Sem isso, vale a heurística por nome em src/agent/tool-policy.ts (checkout, pay, address...).
MCP_CONFIRM_TOOLS=
# Opcional: domínios extras (vírgula) cujos links o bot pode mostrar com rótulo; ifood.com.br já vale.
TRUSTED_LINK_HOSTS=
# Opcional: domínios extras (vírgula) de onde o bot pode enviar fotos; ifood-static.com.br e ifood.com.br já valem.
TRUSTED_IMAGE_HOSTS=
# Opcional: prefixo para caminhos relativos de imagem (ex.: "pratos/abc.jpg") vindos do MCP.
IFOOD_IMAGE_BASE_URL=
# Depuração: 1 = loga a saída completa de cada ferramenta MCP (contém dados pessoais).
MCP_LOG_RAW=
